{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*Controller.ts"],
  "spec": {
    "outputDirectory": "routes",
    "specVersion": 3,
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "routes": {
    "authenticationModule": "src/authentication.ts",
    "routesDir": "routes",
    "esm": true,
    "basePath": "api"
  },
  "compilerOptions": {
    "rootDir": "./",
    "paths": {
      "@/*": ["./*"]
    }
  }
}
