# API listens to this port
PORT=3000

# Path for config subscriptions for end users
SUBSCRIPTION_PATH=/sub

# Whether to download Mihomo prereleases
ALLOW_MIHOMO_PRERELEASE=false

# Github repo where to download the binary from
MIHOMO_REPO=MetaCubeX/mihomo

# Overrides which platform to download Mihomo for; only relevant for
# platforms that are neither x64 nor arm64. Must match a Mihomo release artifact name
MIHOMO_ARCH=amd64-v2
